# Copia este archivo a ".env" y ajústalo. Lo usan Docker Compose y el backend.

# --- Base de datos ---------------------------------------------------------
# Local sin Docker (por defecto si no se define): SQLite en artifacts/sistema.db
#   DATABASE_URL=sqlite:///./artifacts/sistema.db
# Con Docker Compose (servicio 'db' de Postgres):
DATABASE_URL=postgresql+psycopg2://sistema:sistema@db:5432/sistema_oc

# Credenciales del Postgres del compose (deben coincidir con DATABASE_URL).
POSTGRES_USER=sistema
POSTGRES_PASSWORD=sistema
POSTGRES_DB=sistema_oc

# Puerto del host donde se expone Postgres (contenedor sigue en 5432 internamente).
# Conectar clientes externos a localhost:5438.
DB_HOST_PORT=5438

# --- API -------------------------------------------------------------------
# Orígenes permitidos para CORS (separados por comas).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost

# --- Frontend (Vite) -------------------------------------------------------
# URL del API que consume el frontend.
VITE_API_URL=http://localhost:8000
